
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    HOST=0.0.0.0 \
    PORT=8080

# Install system dependencies required by Playwright and Chromium
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libatomic1 \
        libglib2.0-0 \
        libnss3 \
        libnspr4 \
        libdbus-1-3 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libcups2 \
        libdrm2 \
        libxkbcommon0 \
        libatspi2.0-0 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxrandr2 \
        libgbm1 \
        libasound2 \
        libpango-1.0-0 \
        libcairo2 \
        libx11-6 \
        libxcb1 \
        libxext6 \
        libx11-xcb1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-sandbox.txt .

RUN pip install --no-cache-dir -r requirements-sandbox.txt \
    && python -m playwright install chromium \
    && groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --home-dir /app app \
    && chmod -R a+rX /ms-playwright

COPY src ./src

RUN mkdir -p /app/data/screenshots \
    && chown -R app:app /app/data

USER 10001:10001

EXPOSE 8080

CMD ["python", "-m", "uvicorn", "src.agent.browser_sandbox:app", "--host", "0.0.0.0", "--port", "8080"]
