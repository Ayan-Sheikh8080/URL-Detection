FROM python:3.11-slim AS builder

WORKDIR /app

# Install system dependencies for Playwright
RUN apt-get update && apt-get install -y \
    chromium \
    chromium-sandbox \
    firefox \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements-sandbox.txt .
RUN pip install --no-cache-dir -r requirements-sandbox.txt

# Copy sandbox code
COPY src/agent ./src/agent

# Runtime stage
FROM python:3.11-slim

WORKDIR /app

# Copy Chromium from builder
COPY --from=builder /usr/bin/chromium /usr/bin/chromium
COPY --from=builder /usr/share/ca-certificates /usr/share/ca-certificates

# Install minimal Python dependencies
COPY requirements-sandbox.txt .
RUN pip install --no-cache-dir -r requirements-sandbox.txt

# Copy sandbox code
COPY --from=builder /app/src/agent ./src/agent

# Security enhancements
ENV CHROMIUM_FLAGS="--no-sandbox --disable-dev-shm-usage --disable-gpu --single-process"
ENV PYTHONUNBUFFERED=1
ENV PORT=8080

# Expose sandbox port
EXPOSE 8080

# Start the sandbox service
CMD ["python", "-m", "src.agent.browser_sandbox"]