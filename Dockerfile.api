FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOST=0.0.0.0 \
    PORT=8000 \
    MLFLOW_TRACKING_URI=sqlite:////app/mlflow.db

COPY requirements-training.txt requirements-runtime.txt .
RUN pip install --no-cache-dir --retries 5 --timeout 120 -r requirements-training.txt
COPY src ./src
COPY data/raw ./data/raw
RUN python -m src.data.prepare --strict \
    && python -m src.training.train \
    && groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --home-dir /app app \
    && mkdir -p /app/data/monitoring /app/data/screenshots \
    && chown -R app:app /app/data /app/models /app/reports

USER 10001:10001
EXPOSE 8000
CMD ["python", "-m", "src.start"]
