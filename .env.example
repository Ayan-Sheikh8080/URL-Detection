# ---- Agent / API ----
# Leave SANDBOX_URL empty for local in-process Playwright (dev only).
SANDBOX_URL=
SANDBOX_TIMEOUT_SECONDS=20

# Reasoning layer: "rule_based" (offline) or "bedrock" (Amazon Bedrock LLM).
LLM_PROVIDER=rule_based
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
AWS_REGION=us-east-1

# Verdict thresholds
PHISHING_THRESHOLD=0.65
SUSPICIOUS_THRESHOLD=0.35

# Safety
BLOCK_PRIVATE_NETWORKS=true
BROWSER_HEADLESS=true

# ---- MLOps ----
MODEL_DIR=models
# MLflow tracking: empty -> local SQLite (mlflow.db). Set a server URI in prod.
MLFLOW_TRACKING_URI=
# DVC remote (S3)
# DVC_S3_BUCKET=s3://my-phishing-dvc-remote
