# Environment variables for Phishing URL Analyzer
# Copy to .env and fill in your values

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# ECR Repositories (will be created or use existing)
ECR_API_REPO=phishing-api
ECR_SANDBOX_REPO=phishing-sandbox

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_BUCKET=mlflow-artifacts-phishing

# Server Configuration
PORT=8000
NODE_ENV=development

# Security
SANDBOX_URL=http://sandbox.local:8080
CORS_ORIGINS=http://localhost:3000

# Optional LLM Configuration
LLM_PROVIDER=rule_based  # or "bedrock"
BEDROCK_MODEL_ID=arn:aws:bedrock:region:account-id:model/claude-3-haiku-20240307