# Environment variables for Phishing URL Analyzer
# Copy to .env and fill in your values

# Optional AWS configuration. The local rule-based pipeline needs no AWS account.
AWS_REGION=us-east-1

# Optional MLflow server. Without this, MLflow logs to ./mlruns.
# MLFLOW_TRACKING_URI=http://localhost:5000

# Server Configuration
PORT=8000
HOST=0.0.0.0
BROWSER_TIMEOUT_MS=8000

# Set only when the isolated browser sandbox is available.
# BROWSER_SANDBOX_URL=http://sandbox:8080

# Optional LLM Configuration
LLM_PROVIDER=rule_based
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0